; Engine configuration file.
; Park Ski prototype — Godot 4.7.2 stable, Forward+, Jolt Physics.
config_version=5

[application]
config/name="Summit Sessions"
run/main_scene="res://world/resort.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.07, 0.11, 1)

[autoload]
GameSettings="*res://autoload/game_settings.gd"
InputManager="*res://autoload/input_manager.gd"
SessionManager="*res://autoload/session_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4

[input]
steer_left={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
steer_right={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
trick_left={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]}
trick_right={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":4194323), Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]}
trick_up={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]}
trick_down={"deadzone": 0.18, "events": [Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]}
tuck={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]}
brake={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194326), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":1)]}
grab_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventJoypadButton,"button_index":9)]}
grab_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":10)]}
respawn={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":3), Object(InputEventJoypadButton,"button_index":12)]}
set_marker={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":84), Object(InputEventJoypadButton,"button_index":11)]}
pause={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]}
debug_toggle={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194332)]}

[layer_names]
3d_physics/layer_1="Terrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="Features"
