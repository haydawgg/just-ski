; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Summit Sessions"
run/main_scene="res://world/resort.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.07, 0.11, 1)

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

GameSettings="*res://autoload/game_settings.gd"
InputManager="*res://autoload/input_manager.gd"
SessionManager="*res://autoload/session_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
ClipRecorder="*res://autoload/clip_recorder.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/theme/summit_theme.tres"

